DATABASE_URL=postgresql://postgres:postgres@localhost:5433/roam
GROQ_API_KEY=
DATABASE_SSLMODE=
NOMINATIM_USER_AGENT=ROAM/0.1 (dev@localhost)

# Vision escalation for ParcelMap crops. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Sign in with Google: an OAuth "Web application" client id (Google Cloud console -> APIs & Services ->
# Credentials), with the site's URL as an authorised JavaScript origin.
GOOGLE_CLIENT_ID=
# Signs ROAM's session tokens; generated into data/.session_secret when empty (set it explicitly in production).
SESSION_SECRET=
# Google accounts allowed to change the shared sample documents (comma-separated).
ADMIN_EMAILS=
