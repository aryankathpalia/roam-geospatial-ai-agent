		"@tailwindcss/line-clamp": "^0.4.4",
		"@types/leaflet": "^1.9.22",
		"autoprefixer": "^10.4.24",
		"postcss": "^8.5.6",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"leaflet": "^1.9.4",
		"lucide-svelte": "^0.577.0"
