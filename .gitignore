# Claude Code local tooling directory -- not part of the deployed app.
.claude/

# Regenerable YOLO fine-tune dataset export (rebuild via
# app/pipeline/prepare_finetune_dataset.py from data/documents +
# data/annotations any time it's needed).
data/finetune_dataset/
data/finetune_dataset.zip

# Real land-record documents (rendered pages, uploads, human review
# crops) -- these are actual government records with real people's
# names/addresses/parcel numbers. Kept local only, not pushed publicly.
# data/annotations/ (small, just class labels) is intentionally NOT
# excluded -- it documents the training work without exposing document
# content.
data/documents/
data/raw/
new_test_docs/
*/review_crops/
/scratch_diag/

# Ad hoc test PDFs dropped at the repo root during model testing.
/*.pdf

# Superseded/unneeded model artifacts -- roam_layout_best.int8.onnx
# (the deployed model) and roam_layout_best.pt (used by the PyTorch/
# CVAT-annotation dev path) are the only weights actually needed and
# are NOT excluded.
models/roam_layout_v1/roam_layout_last.pt
models/roam_layout_v1/roam_layout_best.onnx
models/roam_layout_v1/roam_layout_best.onnx.data

!frontend/src/routes/documents/

# Raw frontend design references (source mockups, unoptimized scans) --
# the actual images used in the built UI are already committed under
# frontend/static/images/; this is just the working asset library.
/assets_frontend/

# Ad hoc live-test artifacts dropped at the repo root while verifying
# Modal deploys this session (pipeline result JSON dumps, curl headers,
# modal log tails) -- not meant to be committed.
/doc14_result*.json
/placerville_result*.json
/headers*.txt
/modal_logs.txt
